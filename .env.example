# .env - Example configuration for the proxy server
HOST=0.0.0.0
PORT=8888

# MLX model to load
MODEL_NAME=mlx-community/GLM-4.5-Air-3bit
CLAUDE_MLX_ADAPTER=qwen3

# You can also specify
# DEFAULT_TEMPERATURE=1.0
# DEFAULT_TOP_P=1.0
# DEFAULT_MAX_TOKENS=4096
# TRUST_REMOTE_CODE=true
# VERBOSE=true

